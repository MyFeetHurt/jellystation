#!/command/with-contenv bash
# pcscd for the B-CAS card reader (recisdb). Off with JELLYSTATION_PCSCD=false or when no USB bus is passed in.
if [[ "${JELLYSTATION_PCSCD:-auto}" =~ ^(0|false|no)$ ]] || { [ "${JELLYSTATION_PCSCD:-auto}" = auto ] && [ ! -d /dev/bus/usb ]; }; then
  exec sleep infinity
fi
mkdir -p /run/pcscd
# polkit (Debian default) is not running in the container and would refuse every client.
exec pcscd --foreground --disable-polkit
