#!/bin/bash
# Finds the tuner devices passed to the container and prints a Mirakurun tuners.yml for them.
#   jellystation-tuners           print the result (and what was found) without changing anything
#   jellystation-tuners --write   write /config/mirakurun/tuners.yml (the old one is kept as tuners.yml.bak); restart after
#   jellystation-tuners --devices print the device paths to pass to the container, one per line (jellystation-compose
#                                 runs this against the host's /dev, where DVB frontends can be listed but not opened)
# Devices: px4_drv character devices (PLEX PX-W3/Q3/MLT/M1UR/S1UR, e-Better DTV02A/DTV03A) by their names, and DVB
# adapters (PT1/PT2/PT3, PX-S1UD/Q1UD, ...) by the delivery systems their frontend reports.
set -uo pipefail
OUT=/config/mirakurun/tuners.yml
TUNE=/opt/jellystation/bin/tune
n_gr=0 n_s=0 yaml="" devices=()

add() { # add NAME DEVICE TYPES
  yaml+="- name: $1"$'\n'"  types: [$3]"$'\n'"  command: $TUNE $2 <type> <channel>"$'\n'
  [[ $3 == *GR* ]] && n_gr=$((n_gr + 1))
  [[ $3 == *BS* ]] && n_s=$((n_s + 1))
  [[ $2 == /dev/dvb/* ]] || devices+=("$2")
  echo "  $1: $2 ($3)" >&2
}

echo "tuner devices:" >&2
shopt -s nullglob
# PX-W3U4/W3PE4/W3PE5 and PX-Q3U4/Q3PE4/Q3PE5: S, S, T, T per group of four.
for d in /dev/px4video*; do
  i=${d#/dev/px4video}
  if (( i % 4 < 2 )); then add "PX4-S$i" "$d" "BS, CS"; else add "PX4-T$i" "$d" "GR"; fi
done
# PT1/PT2/PT3 with the older out-of-tree drivers (pt1_drv, pt3_drv) instead of the kernel's DVB ones: same order.
for d in /dev/pt1video* /dev/pt3video*; do
  b=${d#/dev/}; i=${b##*video}; p=${b%video*}; p=${p^^}
  if (( i % 4 < 2 )); then add "$p-S$i" "$d" "BS, CS"; else add "$p-T$i" "$d" "GR"; fi
done
# Tuners that take both terrestrial and satellite on one device file.
for d in /dev/pxmlt5video* /dev/pxmlt8video* /dev/pxm1urvideo* /dev/isdb2056video* /dev/isdb6014video*; do
  b=${d#/dev/}; add "${b%video*}-${b##*video}" "$d" "GR, BS, CS"
done
# Terrestrial only.
for d in /dev/pxs1urvideo* /dev/isdbt2071video*; do
  b=${d#/dev/}; add "${b%video*}-${b##*video}" "$d" "GR"
done
# DVB adapters (kernel drivers). A frontend that supports both systems is used for both.
for a in /dev/dvb/adapter*; do
  [ -e "$a/frontend0" ] || continue
  i=${a#/dev/dvb/adapter}
  if [ "${1:-}" = --devices ]; then devices+=(/dev/dvb); break; fi
  info=$(dvb-fe-tool -a "$i" 2>&1 || true)
  t=()
  [[ $info == *ISDBT* ]] && t+=(GR)
  [[ $info == *ISDBS* ]] && t+=(BS CS)
  if (( ${#t[@]} )); then
    add "DVB$i" "$a/frontend0" "$(IFS=,; echo "${t[*]}" | sed 's/,/, /g')"
  else
    echo "  $a: not an ISDB tuner, skipped" >&2
  fi
done

# B-CAS card reader: a USB smart card (CCID, class 0b) interface on the host, usable when /dev/bus/usb is passed in.
reader=no
for c in /sys/bus/usb/devices/*/bInterfaceClass; do
  [ "$(cat "$c" 2>/dev/null)" = 0b ] && reader=yes
done
total=$(grep -c '^- name' <<< "$yaml")
echo "found $total tuners ($n_gr terrestrial, $n_s satellite)" >&2
if [ $reader = no ]; then
  echo "WARNING: no smart card reader found: recordings will stay scrambled without a B-CAS card in a reader" >&2
elif [ ! -d /dev/bus/usb ]; then
  echo "WARNING: a smart card reader is connected, but /dev/bus/usb is not passed to the container: add it to devices" >&2
else
  echo "B-CAS card reader: found" >&2
fi
if [ "${1:-}" = --devices ]; then
  [ ${#devices[@]} -gt 0 ] && printf '%s\n' "${devices[@]}"
  exit 0
fi
[ "$total" -gt 0 ] || exit 1

yaml="# Generated by jellystation-tuners from the devices passed to the container. Edit as you like; it is not
# generated again while this file exists. tune runs recisdb (descrambling with the B-CAS card through pcscd).
$yaml"
if [ "${1:-}" = --write ]; then
  [ -f "$OUT" ] && cp "$OUT" "$OUT.bak"
  printf '%s' "$yaml" > "$OUT"
  echo "wrote $OUT" >&2
else
  printf '%s' "$yaml"
fi
